var TV2_CARDRUSH_CSV='https://docs.google.com/spreadsheets/d/e/2PACX-1vQT3Q9qDbZUpnP3_WH2I5qw8O-U_PqXVhhoIzH2o-tSzeDND9FTuoGKbZiNHTbrzTgKAUA2_SvXFh_2/pub?gid=1490875147&single=true&output=csv';
function fetchTorecaVaultV2CardQuotes(targets){var rows=tv2mFetchRows_(),date=Utilities.formatDate(new Date(),'Asia/Tokyo','yyyy-MM-dd');return(targets||[]).map(function(t){var model=tv2mExtractModel_(t),hit=model?tv2mFind_(rows,t.product,model):null;return hit?{ok:true,product:t.product,productKey:t.productKey,category:t.category,condition:t.condition,price:hit.price,checkedAt:date,source:'カードラッシュ'}:{ok:false,product:t.product,model:model}})}
function tv2mExtractModel_(x){var text=[x.set,x.product,x.productKey].filter(Boolean).join(' ').normalize('NFKC');var m=text.match(/\b[A-Z0-9-]*\d[A-Z0-9-]*\s+\d{3}\/\d{3}\b/i)||text.match(/\b\d{3}\/\d{3}\b/i);return m?m[0].toUpperCase().replace(/\s+/g,' '):''}
function tv2mFetchRows_(){var r=UrlFetchApp.fetch(TV2_CARDRUSH_CSV+'&v='+Date.now(),{muteHttpExceptions:true,followRedirects:true});if(r.getResponseCode()!==200)throw new Error('Cardrush CSV HTTP '+r.getResponseCode());return Utilities.parseCsv(r.getContentText('UTF-8'))}
function tv2mNorm_(x){return String(x||'').normalize('NFKC').toLowerCase().replace(/\s+/g,'')}
function tv2mFind_(rows,product,model){var pn=tv2mNorm_(String(product||'').replace(model,'')),mn=tv2mNorm_(model),hits=rows.filter(function(row){var t=tv2mNorm_(row.join(' '));return t.indexOf(pn)>=0&&t.indexOf(mn)>=0}).map(function(row){var ps=row.map(function(cell){var s=String(cell||'').normalize('NFKC').replace(/[,，円¥￥\s]/g,'');return /^\d{2,7}$/.test(s)?Number(s):0}).filter(function(x){return x>=10});return ps.length?ps[ps.length-1]:0}).filter(Boolean),unique=hits.filter(function(x,i,a){return a.indexOf(x)===i});return unique.length===1?{price:unique[0]}:null}
