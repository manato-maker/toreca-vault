# Configure these only in a local emulator or Cloud Run Secret Manager.
TV2_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
TV2_FIRESTORE_DOCUMENT=torecaVaultV2/canonical
TV2_ALLOWED_ORIGINS=https://manato-maker.github.io
TV2_ENABLE_WRITES=false
TV2_ENABLE_COMMAND_QUEUE=false
TV2_ENABLE_COMMAND_WORKER=false
# Required only when the reviewed worker is explicitly enabled; these are identifiers, not secrets.
TV2_SCHEDULER_AUDIENCE=https://replace-with-cloud-run-service-url
TV2_SCHEDULER_SERVICE_ACCOUNT_EMAIL=replace-with-scheduler-service-account
PORT=8080
# Dedicated new-app-only Google Sheet. Keep disabled until reviewed and configured.
TV2_ENABLE_GOOGLE_SHEETS_INTAKE=false
TV2_NEW_APP_INTAKE_SPREADSHEET_ID=replace-with-dedicated-sheet-id
