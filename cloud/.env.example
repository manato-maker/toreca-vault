# Configure these only in a local emulator or Cloud Run Secret Manager.
TV2_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
TV2_FIRESTORE_DOCUMENT=torecaVaultV2/canonical
TV2_ALLOWED_ORIGINS=https://manato-maker.github.io
TV2_ENABLE_WRITES=false
TV2_ENABLE_COMMAND_QUEUE=false
TV2_ENABLE_COMMAND_WORKER=false
# Set only as a Secret Manager reference when a reviewed non-production worker is enabled.
TV2_WORKER_TOKEN=replace-with-a-different-random-secret-at-least-32-characters
PORT=8080
